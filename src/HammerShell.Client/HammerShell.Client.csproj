<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- public members without XML docs are fine; everything else stays an error -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>EpicMorg.HammerShell.Client</PackageId>
    <Description>Client for the shell channel of Valve Hammer Editor (Source 1): send entity and AI node edit commands to the map open in a running Hammer (Worldcraft_ShellMessageWnd / WM_COPYDATA, the mechanism behind editor_sendcommand in the Source SDK). Windows only.</Description>
    <PackageTags>hammer;valve;source-engine;source-sdk;level-editor;mapping;vmf;worldcraft</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EpicMorg/HammerShell</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EpicMorg/HammerShell</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
